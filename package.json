{
    "name": "bpr-conference-server",
    "version": "0.1.0",
    "private": true,
    "type": "commonjs",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "tsx watch src/main.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/main.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "check": "npm run format:check && npm run typecheck && npm run test && npm run build"
    },
    "dependencies": {
        "@livekit/rtc-node": "^0.13.27",
        "@nestjs/common": "^11.1.29",
        "@nestjs/core": "^11.1.29",
        "@nestjs/platform-express": "^11.1.29",
        "@soundtouchjs/core": "2.1.1",
        "livekit-server-sdk": "^2.15.2",
        "pino": "^10.3.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "ws": "^8.20.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^20",
        "@types/ws": "^8.18.1",
        "prettier": "^3.9.6",
        "tsx": "^4.23.12",
        "typescript": "^5",
        "vitest": "^4.1.10"
    }
}
